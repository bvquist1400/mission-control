{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/intelligence/run/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/mcp/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/mcp-upstream/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/launch-metrics/sync/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/calendar/sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/tasks/generate-recurring",
      "schedule": "0 4,5 * * *"
    },
    {
      "path": "/api/intelligence/run",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/intelligence/run",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/intelligence/run",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/intelligence/run",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/launch-metrics/sync?kind=full",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/launch-metrics/sync?kind=light",
      "schedule": "15 * * * *"
    }
  ]
}
